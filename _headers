/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/config/*
  Cache-Control: public, max-age=0, must-revalidate

/guestbook-admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/analytics-admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store

/data/*
  Cache-Control: public, max-age=300, must-revalidate

/media/*
  Cache-Control: public, max-age=31536000, immutable
